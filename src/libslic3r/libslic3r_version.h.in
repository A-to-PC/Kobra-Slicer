#ifndef __SLIC3R_VERSION_H
#define __SLIC3R_VERSION_H

#define SLIC3R_APP_NAME "@SLIC3R_APP_NAME@"
#define SLIC3R_APP_KEY "@SLIC3R_APP_KEY@"
#define SLIC3R_VERSION "@SLIC3R_VERSION@"
// Kobra Slicer's own product-facing release version -- independent of SLIC3R_VERSION above,
// which tracks OrcaSlicer's own internal engine/build numbering and is relied on elsewhere for
// real 3mf/config compatibility checks. This one is just "what version of Kobra Slicer is
// this" -- semantic versioning, 0.x.y pre-release, 1.0.0 at first public release.
#define KOBRA_SLICER_VERSION "@KOBRA_SLICER_VERSION@"
#define SoftFever_VERSION "@SoftFever_VERSION@"
#ifndef GIT_COMMIT_HASH
    #define GIT_COMMIT_HASH "0000000" // 0000000 means uninitialized
#endif
#define SLIC3R_BUILD_ID "@SLIC3R_BUILD_ID@"
//#define SLIC3R_RC_VERSION "@SLIC3R_VERSION@"
#define BBL_INTERNAL_TESTING @BBL_INTERNAL_TESTING@
#define ORCA_CHECK_GCODE_PLACEHOLDERS @ORCA_CHECK_GCODE_PLACEHOLDERS@

#endif /* __SLIC3R_VERSION_H */
